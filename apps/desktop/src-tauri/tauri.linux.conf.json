{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "nib",
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "category": "GraphicsAndDesign",
    "longDescription": "Draw shapes, connect them with arrows that stay attached, label them, sketch freehand and export what you made. Drawings are plain JSON files you own: no account, no network.",
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "depends": ["shared-mime-info", "xdg-utils"],
        "section": "graphics",
        "desktopTemplate": "../linux/nib.desktop",
        "files": {
          "/usr/share/mime/packages/nib.xml": "../linux/nib-mime.xml"
        }
      },
      "rpm": {
        "depends": ["shared-mime-info", "xdg-utils"],
        "desktopTemplate": "../linux/nib.desktop",
        "files": {
          "/usr/share/mime/packages/nib.xml": "../linux/nib-mime.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/mime/packages/nib.xml": "../linux/nib-mime.xml"
        }
      }
    }
  }
}
