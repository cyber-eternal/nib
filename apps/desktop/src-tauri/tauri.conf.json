{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nib",
  "version": "../package.json",
  "identifier": "app.nib.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "visible": false,
        "title": "Nib",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src https://www.youtube-nocookie.com https://player.vimeo.com https://figma.com https://*.figma.com https://www.loom.com https://gist.github.com https://codepen.io https://codesandbox.io https://stackblitz.com https://*.stackblitz.com https://excalidraw.com https://*.excalidraw.com https://open.spotify.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "copyright": "",
    "shortDescription": "An infinite hand-drawn whiteboard",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": ["nibd"],
        "name": "Nib drawing",
        "description": "Nib whiteboard drawing",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/vnd.nib+json",
        "exportedType": {
          "identifier": "app.nib.desktop.nibd",
          "conformsTo": ["public.json", "public.data"]
        }
      },
      {
        "ext": ["excalidraw"],
        "name": "Excalidraw Drawing",
        "description": "Excalidraw drawing",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/vnd.excalidraw+json"
      }
    ],
    "createUpdaterArtifacts": false
  }
}
